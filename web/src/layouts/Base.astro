---
import '../styles/site.css';
import Analytics from '@vercel/analytics/astro';
interface Props { title: string; description: string; image?: string; type?: string; jsonld?: object | object[]; home?: boolean; }
const { title, description, image = '/og.jpg', type = 'website', jsonld, home = false } = Astro.props;
const site = Astro.site ?? new URL('https://www.emilianomoretti.com');
const canonical = new URL(Astro.url.pathname, site).href;
const ogImage = new URL(image, site).href;
const h = home ? '' : '/';
const lds = jsonld ? (Array.isArray(jsonld) ? jsonld : [jsonld]) : [];
---
<!doctype html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>{title}</title>
<meta name="description" content={description}>
<meta name="author" content="Emiliano Moretti">
<link rel="canonical" href={canonical}>
<meta property="og:type" content={type}>
<meta property="og:locale" content="es_ES">
<meta property="og:site_name" content="Emiliano Moretti">
<meta property="og:url" content={canonical}>
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:image" content={ogImage}>
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:site" content="@EmilianoMorett5">
<meta name="twitter:title" content={title}>
<meta name="twitter:description" content={description}>
<meta name="twitter:image" content={ogImage}>
<link rel="alternate" type="application/rss+xml" title="Blog de Emiliano Moretti" href="/rss.xml">
<link rel="sitemap" href="/sitemap-index.xml">
<script is:inline>try{var t=localStorage.getItem("em-theme");if(t==="dark"||t==="light")document.documentElement.setAttribute("data-theme",t)}catch(e){}</script>
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="apple-touch-icon" href="/apple-touch-icon.png">
<meta name="theme-color" content="#FFFFFF" media="(prefers-color-scheme: light)">
<meta name="theme-color" content="#0B0B0B" media="(prefers-color-scheme: dark)">
<link rel="preload" href="/fonts/geist-mono-500.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="/fonts/inter-tight-400.woff2" as="font" type="font/woff2" crossorigin>
{lds.map((ld) => <script type="application/ld+json" set:html={JSON.stringify(ld)} />)}
<slot name="head" />
<Analytics />
</head>
<body>
<nav class="nav" id="nav" aria-label="Principal">
  <div class="wrap">
    <a class="brand" href="/"><span class="wm"><span class="pr" aria-hidden="true">&gt;</span> emiliano moretti<span class="cur" aria-hidden="true"></span></span><small>Madrid</small></a>
    <div class="nav-links">
      <a class="t" href={`${h}#como`}>Cómo funciona</a>
      <a class="t" href={`${h}#detras`}>Detrás</a>
      <a class="t" href="/blog/">Blog</a>
      <span class="acts"><button class="icon-btn theme-btn" type="button" id="themeBtn" aria-label="Cambiar a modo oscuro"><svg class="ic-moon" viewBox="0 0 16 16" aria-hidden="true"><path d="M13.5 9.5A5.5 5.5 0 0 1 6.5 2.5a5.5 5.5 0 1 0 7 7z"/></svg><svg class="ic-sun" viewBox="0 0 16 16" aria-hidden="true"><circle cx="8" cy="8" r="3"/><path d="M8 1.5v1.5M8 13v1.5M1.5 8H3M13 8h1.5M3.4 3.4l1 1M11.6 11.6l1 1M3.4 12.6l1-1M11.6 4.4l1-1"/></svg></button><a class="pill pill-ink pill-sm" href={`${h}#contacto`}>Contacto</a></span>
    </div>
  </div>
</nav>
<slot />
<footer>
  <div class="wrap">
    <div class="about"><a class="brand" href="/"><span class="wm"><span class="pr" aria-hidden="true">&gt;</span> emiliano moretti<span class="cur" aria-hidden="true"></span></span></a><p>Director comercial en Modulor Studios. Vendo con Claude y lo cuento mientras lo construyo.</p></div>
    <div><h4>Explorar</h4><ul><li><a href={`${h}#como`}>Cómo funciona</a></li><li><a href={`${h}#detras`}>Detrás del proceso</a></li><li><a href={`${h}#criterio`}>Lo que no automatizo</a></li><li><a href="/blog/">Blog</a></li></ul></div>
    <div><h4>Contacto</h4><ul><li><button type="button" data-copy="emiliano@modulorstudios.com">Copiar email</button></li><li><a href="https://www.linkedin.com/in/emiliano-moretti/" target="_blank" rel="noopener">LinkedIn</a></li><li><a href="https://x.com/EmilianoMorett5" target="_blank" rel="noopener">X</a></li><li><a href="/rss.xml">RSS</a></li></ul></div>
  </div>
</footer>
<div class="toast" id="toast" role="status" aria-live="polite">Email copiado</div>
<script is:inline>
(function(){
  var root = document.documentElement, tbtn = document.getElementById('themeBtn');
  function effTheme(){ var t = root.getAttribute('data-theme'); return t || (window.matchMedia && matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light'); }
  function syncTheme(){ var d = effTheme() === 'dark'; tbtn.setAttribute('aria-label', d ? 'Cambiar a modo claro' : 'Cambiar a modo oscuro'); }
  tbtn.addEventListener('click', function(){ var n = effTheme() === 'dark' ? 'light' : 'dark'; root.setAttribute('data-theme', n); try { localStorage.setItem('em-theme', n); } catch (e) {} syncTheme(); });
  syncTheme();
  var nav = document.getElementById('nav');
  function solid(){ nav.classList.toggle('solid', scrollY > 8); }
  addEventListener('scroll', solid, { passive: true }); solid();
  var toast = document.getElementById('toast'), tt;
  window.emSay = function(m){ toast.textContent = m; toast.classList.add('on'); clearTimeout(tt); tt = setTimeout(function(){ toast.classList.remove('on'); }, 1800); };
  document.querySelectorAll('[data-copy]').forEach(function(b){
    b.addEventListener('click', function(){
      var v = b.getAttribute('data-copy'), msg = b.getAttribute('data-copy-msg') || 'Email copiado';
      function fb(){ emSay(v); }
      try { navigator.clipboard.writeText(v).then(function(){ emSay(msg); }, fb); } catch (e) { fb(); }
    });
  });
})();
</script>
</body>
</html>
