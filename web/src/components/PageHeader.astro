---
// Cabecera común de páginas principales (Blog, 404, UI Kit) y artículos. Ver /ui-kit/.
// label: etiqueta ">_" de arriba (en artículos va la ruta de migas por el slot "kicker").
// title + gray: el H1 en dos tonos (lo que afirmo en negro, el contexto en gris). lead: bajada opcional.
interface Props { label?: string; title: string; gray?: string; lead?: string; }
const { label, title, gray, lead } = Astro.props;
---
<header class="page-head">
  {Astro.slots.has('kicker') ? <slot name="kicker" /> : label && <p class="eyebrow"><span class="num">&gt;_</span>{label}</p>}
  <h1 class="page-h1">{title}{gray && <> <span class="g">{gray}</span></>}</h1>
  {lead && <p class="page-lead">{lead}</p>}
</header>
