---
// "Cómo funciona" en escritorio (más de 900 px): una fila por paso con el mismo recorrido,
// entra → Claude → Notion → sale. Claude y Notion atraviesan todos los pasos. En celular se ve la grilla de siempre.
// El scroll la pinta desde src/components/HomeScript.astro. Ver /ui-kit/.
interface Props { lang?: 'es' | 'en'; }
const { lang = 'es' } = Astro.props;
const T = {
  es: {
    head: ['entra', 'claude', 'notion', 'sale'],
    rows: [
      ['Gmail', 'Llega el lead', 'investiga', 'cuenta', 'Yo', 'Sé quién escribe'],
      ['Calendar · Granola', 'Agenda y graba', 'completa', 'ficha', 'Ficha completa', 'Con lo que dijo el cliente'],
      ['Granola', 'Resumen de la llamada', 'resume', 'ficha', 'Slack', 'Pide la estimación'],
      ['Slack', 'Estimación del equipo', 'arma', 'contexto', 'Claude Design', 'Propuesta con su marca'],
      ['Pasos 01–04', 'Lo que pasó', 'actualiza', 'historial', 'HubSpot · Instinct', 'Pipeline al día'],
    ],
  },
  en: {
    head: ['in', 'claude', 'notion', 'out'],
    rows: [
      ['Gmail', 'The lead comes in', 'looks up', 'account', 'Me', 'I know who’s writing'],
      ['Calendar · Granola', 'Books and records', 'fills in', 'file', 'Complete file', 'With what the client said'],
      ['Granola', 'Call summary', 'sums up', 'file', 'Slack', 'Requests the estimate'],
      ['Slack', 'Team estimate', 'builds', 'context', 'Claude Design', 'Branded proposal'],
      ['Steps 01–04', 'What happened', 'updates', 'history', 'HubSpot · Instinct', 'Pipeline up to date'],
    ],
  },
}[lang];
---
<div class="flow" id="flow" aria-hidden="true">
  <span class="fl-h" style="--c:2">{T.head[0]}<i>→</i></span>
  <span class="fl-h hub" style="--c:3">{T.head[1]}<span class="cur"></span><i>→</i></span>
  <span class="fl-h" style="--c:4">{T.head[2]}<i>→</i></span>
  <span class="fl-h" style="--c:5">{T.head[3]}</span>
  <div class="fl-spine fl-claude"></div>
  <div class="fl-spine fl-notion"><i></i></div>
  {T.rows.map((r, i) => (
    <div class="fl-row" style={`--r:${i + 2}`}>
      <span class="fl-n">{String(i + 1).padStart(2, '0')}</span>
      <span class="fl-line"><i></i></span>
      <div class="fl-tile fl-in"><strong>{r[0]}</strong><small>{r[1]}</small></div>
      <span class="fl-c"><span>{r[2]}</span></span>
      <span class="fl-m"><span>{r[3]}</span></span>
      <div class="fl-tile fl-out"><strong>{r[4]}</strong><small>{r[5]}</small></div>
    </div>
  ))}
</div>
