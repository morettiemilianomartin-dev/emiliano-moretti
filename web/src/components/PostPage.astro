---
// Página de un artículo. La usan /blog/<slug>/ (español) y /en/blog/<slug>/ (inglés).
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import Share from './Share.astro';
import { fmtDate, readingMinutes, postUrl } from '../lib/posts';
import { CAL, ui, type Lang } from '../lib/i18n';
interface Props { post: any; posts: any[]; lang: Lang; alt?: string; }
const { post, posts, lang, alt } = Astro.props;
const es = lang === 'es';
const T = es ? {
  crumbs: 'Miga de pan', home: 'Inicio', updated: 'Actualizado el', min: 'min de lectura', short: 'En corto', toc: 'En este artículo', faq: 'Preguntas frecuentes',
  by: 'Escrito por', bio: 'Director comercial en Modulor Studios. Vende desde 2011 y hoy su proceso comercial corre sobre Claude.', job: 'Director comercial',
  conv: 'Conversación:', share: 'Compartir', cta: '¿Estás en lo mismo?', ctag: 'Charlemos 30 minutos, en Madrid o por videollamada, y comparamos notas.', book: 'Agendemos 30 minutos', more: 'Seguí leyendo',
} : {
  crumbs: 'Breadcrumb', home: 'Home', updated: 'Updated', min: 'min read', short: 'In short', toc: 'In this article', faq: 'Frequently asked questions',
  by: 'Written by', bio: 'Sales director at Modulor Studios. In sales since 2011, and today his sales process runs on Claude.', job: 'Sales director',
  conv: 'Conversation:', share: 'Share', cta: 'Working on the same thing?', ctag: 'Let’s talk for 30 minutes, in Madrid or on a video call, and compare notes.', book: 'Book 30 minutes', more: 'Keep reading',
};
const { Content, headings } = await render(post);
const d = post.data;
const url = new URL(postUrl(lang, post.id), Astro.site).href;
const blogUrl = new URL(ui[lang].blog, Astro.site).href;
const mins = readingMinutes(post.body ?? '');
const related = posts.filter((p) => p.id !== post.id).slice(0, 3);
const person = { "@type": "Person", "@id": new URL('/#person', Astro.site).href, "name": "Emiliano Moretti", "url": Astro.site?.href, "jobTitle": T.job, "worksFor": { "@type": "Organization", "name": "Modulor Studios" }, "sameAs": ["https://www.linkedin.com/in/emiliano-moretti/", "https://x.com/EmilianoMorett5"] };
const posting: Record<string, unknown> = { "@context": "https://schema.org", "@type": "BlogPosting", "headline": d.title, "description": d.description, "datePublished": d.pubDate.toISOString(), "dateModified": (d.updatedDate ?? d.pubDate).toISOString(), "inLanguage": lang, "mainEntityOfPage": url, "url": url, "image": new URL(d.image ?? '/og.jpg', Astro.site).href, "author": person, "publisher": person, "keywords": d.tags.join(', ') };
// Une las dos versiones del artículo para los buscadores.
if (alt) posting[es ? 'workTranslation' : 'translationOfWork'] = { "@type": "BlogPosting", "@id": new URL(alt, Astro.site).href, "url": new URL(alt, Astro.site).href, "inLanguage": es ? 'en' : 'es' };
const lds: object[] = [
  posting,
  { "@context": "https://schema.org", "@type": "BreadcrumbList", "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": T.home, "item": new URL(ui[lang].home, Astro.site).href },
    { "@type": "ListItem", "position": 2, "name": "Blog", "item": blogUrl },
    { "@type": "ListItem", "position": 3, "name": d.title, "item": url } ] },
];
// FAQ visible en la página; sin schema FAQPage (Google retiró ese resultado enriquecido en mayo de 2026).
const toc = headings.filter((h) => h.depth === 2);
// Google corta los títulos largos: el nombre solo se suma si entra.
const pageTitle = d.title.length <= 48 ? `${d.title} · Emiliano Moretti` : d.title;
---
<Base title={pageTitle} description={d.description} image={d.image} type="article" jsonld={lds} lang={lang} alt={alt}>
<Fragment slot="head">
  <meta property="article:published_time" content={d.pubDate.toISOString()} />
  <meta property="article:modified_time" content={(d.updatedDate ?? d.pubDate).toISOString()} />
  <meta property="article:author" content="Emiliano Moretti" />
  {d.tags.map((t: string) => <meta property="article:tag" content={t} />)}
</Fragment>
<main class="post">
  <article class="narrow post-wrap">
    <nav class="crumbs" aria-label={T.crumbs}><a href={ui[lang].blog}>Blog</a><span aria-hidden="true">/</span><span>{d.category}</span></nav>
    <h1 class="post-h1">{d.title}</h1>
    <p class="post-lead">{d.description}</p>
    <div class="post-by">
      <div class="by">
        <img src="/avatar.jpg" alt="" width="40" height="40" loading="lazy" />
        <div><strong>Emiliano Moretti</strong><span><time datetime={d.pubDate.toISOString()}>{fmtDate(d.pubDate, lang)}</time>{d.updatedDate && <> · <span class="post-updated">{T.updated} <time datetime={d.updatedDate.toISOString()}>{fmtDate(d.updatedDate, lang)}</time></span></>} · {mins} {T.min}</span></div>
      </div>
      <Share url={url} title={d.title} lang={lang} />
    </div>
    {!es && alt && <p class="post-lang">First published in Spanish. <a href={alt} hreflang="es" lang="es" data-lang="es">Leer en español</a></p>}

    {d.tldr.length > 0 && (
      <aside class="tldr" aria-label={T.short}>
        <p class="tldr-k">{T.short}</p>
        <ul>{d.tldr.map((t: string) => <li>{t}</li>)}</ul>
      </aside>
    )}

    {toc.length > 2 && (
      <nav class="toc" aria-label={T.toc}>
        <p class="tldr-k">{T.toc}</p>
        <ol>{toc.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol>
      </nav>
    )}

    <div class="prose"><Content /></div>

    {d.faq.length > 0 && (
      <section class="faq" aria-labelledby="faq-h">
        <h2 id="faq-h">{T.faq}</h2>
        {d.faq.map((f: { q: string; a: string }) => <details><summary>{f.q}</summary><p>{f.a}</p></details>)}
      </section>
    )}

    <div class="post-end">
      <div class="by-end">
        <p class="tldr-k">{T.by}</p>
        <p><strong>Emiliano Moretti</strong>. {T.bio}</p>
        {(d.linkedin || d.x) && <p class="also">{T.conv} {d.linkedin && <a href={d.linkedin} target="_blank" rel="noopener">LinkedIn ↗</a>} {d.x && <a href={d.x} target="_blank" rel="noopener">X ↗</a>}</p>}
      </div>
      <div class="share-end"><p class="tldr-k">{T.share}</p><Share url={url} title={d.title} lang={lang} /></div>
    </div>

    <div class="post-cta">
      <p class="statement">{T.cta} <span class="g">{T.ctag}</span></p>
      <a class="pill pill-ink" href={CAL} target="_blank" rel="noopener">{T.book} <svg class="arr arr-x" viewBox="0 0 16 16" aria-hidden="true"><path d="M5 11l6-6M6 5h5v5"/></svg></a>
    </div>

    {related.length > 0 && (
      <section class="related">
        <p class="tldr-k">{T.more}</p>
        <ul>{related.map((p) => <li><a href={postUrl(lang, p.id)}>{p.data.title}</a></li>)}</ul>
      </section>
    )}
  </article>
</main>
</Base>
