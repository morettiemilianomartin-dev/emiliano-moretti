---
import type { Lang } from '../lib/i18n';
interface Props { url: string; title: string; lang?: Lang; }
const { url, title, lang = 'es' } = Astro.props;
const u = encodeURIComponent(url);
const t = encodeURIComponent(title);
const L = lang === 'es'
  ? { share: 'Compartir', li: 'Compartir en LinkedIn', x: 'Compartir en X', wa: 'Compartir por WhatsApp', copy: 'Copiar link', copied: 'Link copiado' }
  : { share: 'Share', li: 'Share on LinkedIn', x: 'Share on X', wa: 'Share on WhatsApp', copy: 'Copy link', copied: 'Link copied' };
---
<div class="share" aria-label={L.share}>
  <a class="icon-btn" href={`https://www.linkedin.com/sharing/share-offsite/?url=${u}`} target="_blank" rel="noopener" aria-label={L.li} title="LinkedIn">
    <svg viewBox="0 0 16 16" aria-hidden="true" class="fill"><rect x="2.3" y="5.8" width="2.4" height="7.7" rx=".3"/><circle cx="3.5" cy="3.4" r="1.4"/><path d="M6.6 5.8h2.3v1.1c.4-.7 1.3-1.3 2.6-1.3 2.1 0 2.9 1.3 2.9 3.6v4.3h-2.4V9.7c0-1.1-.3-1.9-1.4-1.9-1 0-1.6.7-1.6 1.9v3.8H6.6z"/></svg>
  </a>
  <a class="icon-btn" href={`https://x.com/intent/post?text=${t}&url=${u}`} target="_blank" rel="noopener" aria-label={L.x} title="X">
    <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3 2.5l10 11M13 2.5l-10 11"/></svg>
  </a>
  <a class="icon-btn" href={`https://wa.me/?text=${t}%20${u}`} target="_blank" rel="noopener" aria-label={L.wa} title="WhatsApp">
    <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M2.5 13.5l.9-2.9A5.6 5.6 0 1 1 5.6 12.7z"/><path d="M6 6.2c.2 1.6 1.9 3.4 3.7 3.7l.8-.8-1.1-.6-.5.5c-.7-.3-1.4-1-1.7-1.7l.5-.5-.6-1.1z" class="fill"/></svg>
  </a>
  <button class="icon-btn" type="button" data-copy={url} data-copy-msg={L.copied} aria-label={L.copy} title={L.copy}>
    <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M6.8 9.2a2.8 2.8 0 0 0 4 0l2-2a2.8 2.8 0 0 0-4-4l-.7.7"/><path d="M9.2 6.8a2.8 2.8 0 0 0-4 0l-2 2a2.8 2.8 0 0 0 4 4l.7-.7"/></svg>
  </button>
</div>
