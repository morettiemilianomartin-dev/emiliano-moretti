---
import PostPage from '../../components/PostPage.astro';
import { getPosts, getPairs } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPosts('es');
  const { esToEn } = await getPairs();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post, posts, alt: esToEn.has(post.id) ? `/en/blog/${esToEn.get(post.id)}/` : undefined } }));
}
const { post, posts, alt } = Astro.props;
---
<PostPage post={post} posts={posts} lang="es" alt={alt} />
