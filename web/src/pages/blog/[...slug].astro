---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Share from '../../components/Share.astro';
import { getPosts, fmtDate, readingMinutes } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post, posts } }));
}
const { post, posts } = Astro.props;
const { Content, headings } = await render(post);
const d = post.data;
const url = new URL(`/blog/${post.id}/`, Astro.site).href;
const mins = readingMinutes(post.body ?? '');
const related = posts.filter((p) => p.id !== post.id).slice(0, 3);
const person = { "@type": "Person", "@id": new URL('/#person', Astro.site).href, "name": "Emiliano Moretti", "url": Astro.site?.href, "jobTitle": "Director comercial", "worksFor": { "@type": "Organization", "name": "Modulor Studios" }, "sameAs": ["https://www.linkedin.com/in/emiliano-moretti/", "https://x.com/EmilianoMorett5"] };
const lds: object[] = [
  { "@context": "https://schema.org", "@type": "BlogPosting", "headline": d.title, "description": d.description, "datePublished": d.pubDate.toISOString(), "dateModified": (d.updatedDate ?? d.pubDate).toISOString(), "inLanguage": "es", "mainEntityOfPage": url, "url": url, "image": new URL(d.image ?? '/og.png', Astro.site).href, "author": person, "publisher": person, "keywords": d.tags.join(', ') },
  { "@context": "https://schema.org", "@type": "BreadcrumbList", "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Inicio", "item": Astro.site?.href },
    { "@type": "ListItem", "position": 2, "name": "Blog", "item": new URL('/blog/', Astro.site).href },
    { "@type": "ListItem", "position": 3, "name": d.title, "item": url } ] },
];
// FAQ visible en la página; sin schema FAQPage (Google retiró ese resultado enriquecido en mayo de 2026).
const toc = headings.filter((h) => h.depth === 2);
---
<Base title={`${d.title} · Emiliano Moretti`} description={d.description} image={d.image} type="article" jsonld={lds}>
<Fragment slot="head">
  <meta property="article:published_time" content={d.pubDate.toISOString()} />
  <meta property="article:modified_time" content={(d.updatedDate ?? d.pubDate).toISOString()} />
  <meta property="article:author" content="Emiliano Moretti" />
  {d.tags.map((t) => <meta property="article:tag" content={t} />)}
</Fragment>
<main class="post">
  <article class="narrow post-wrap">
    <nav class="crumbs" aria-label="Miga de pan"><a href="/blog/">Blog</a><span aria-hidden="true">/</span><span>{d.category}</span></nav>
    <h1 class="post-h1">{d.title}</h1>
    <p class="post-lead">{d.description}</p>
    <div class="post-by">
      <div class="by">
        <img src="/avatar.jpg" alt="" width="40" height="40" loading="lazy" />
        <div><strong>Emiliano Moretti</strong><span><time datetime={d.pubDate.toISOString()}>{fmtDate(d.pubDate)}</time>{d.updatedDate && <> · <span class="post-updated">Actualizado el <time datetime={d.updatedDate.toISOString()}>{fmtDate(d.updatedDate)}</time></span></>} · {mins} min de lectura</span></div>
      </div>
      <Share url={url} title={d.title} />
    </div>

    {d.tldr.length > 0 && (
      <aside class="tldr" aria-label="En corto">
        <p class="tldr-k">En corto</p>
        <ul>{d.tldr.map((t) => <li>{t}</li>)}</ul>
      </aside>
    )}

    {toc.length > 2 && (
      <nav class="toc" aria-label="Contenido">
        <p class="tldr-k">En este artículo</p>
        <ol>{toc.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol>
      </nav>
    )}

    <div class="prose"><Content /></div>

    {d.faq.length > 0 && (
      <section class="faq" aria-labelledby="faq-h">
        <h2 id="faq-h">Preguntas frecuentes</h2>
        {d.faq.map((f) => <details><summary>{f.q}</summary><p>{f.a}</p></details>)}
      </section>
    )}

    <div class="post-end">
      <div class="by-end">
        <p class="tldr-k">Escrito por</p>
        <p><strong>Emiliano Moretti</strong>. Director comercial en Modulor Studios. Vende desde 2011 y hoy su proceso comercial corre sobre Claude.</p>
        {(d.linkedin || d.x) && <p class="also">Conversación: {d.linkedin && <a href={d.linkedin} target="_blank" rel="noopener">LinkedIn ↗</a>} {d.x && <a href={d.x} target="_blank" rel="noopener">X ↗</a>}</p>}
      </div>
      <div class="share-end"><p class="tldr-k">Compartir</p><Share url={url} title={d.title} /></div>
    </div>

    <div class="post-cta">
      <p class="statement">¿Te muestro mi setup? <span class="g">Treinta minutos, mi pantalla real.</span></p>
      <a class="pill pill-ink" href="https://calendar.google.com/calendar/u/0/appointments/schedules/AcZssZ1_ERerY_SFciQLYK3iSLs8HwhEUT9XIO7E2XoCS4mqluKSFbzKchy6JSY0dDStcfYEp8gJYGx-" target="_blank" rel="noopener">Agendemos 30 minutos <svg class="arr arr-x" viewBox="0 0 16 16" aria-hidden="true"><path d="M5 11l6-6M6 5h5v5"/></svg></a>
    </div>

    {related.length > 0 && (
      <section class="related">
        <p class="tldr-k">Seguí leyendo</p>
        <ul>{related.map((p) => <li><a href={`/blog/${p.id}/`}>{p.data.title}</a></li>)}</ul>
      </section>
    )}
  </article>
</main>
</Base>
