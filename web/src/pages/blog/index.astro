---
import Base from '../../layouts/Base.astro';
import { getPosts, fmtDate } from '../../lib/posts';
const posts = await getPosts();
const ld = { "@context": "https://schema.org", "@type": "Blog", "name": "Blog de Emiliano Moretti", "url": new URL('/blog/', Astro.site).href, "inLanguage": "es", "author": { "@type": "Person", "name": "Emiliano Moretti", "url": Astro.site?.href } };
---
<Base title="Blog · Emiliano Moretti" description="Cómo vendo con Claude, pieza por pieza: conectores, skills, Notion como memoria y lo que decidí no automatizar." jsonld={ld}>
<main class="blog">
  <section class="blog-head">
    <div class="narrow">
      <p class="eyebrow"><span class="num">&gt;_</span>Blog</p>
      <h1 class="statement blog-title">Cómo vendo con Claude, pieza por pieza. <span class="g">Lo que pruebo, lo que funciona y lo que todavía no resolví.</span></h1>
    </div>
  </section>
  <section class="blog-list-wrap">
    <div class="narrow">
      <ol class="blog-list">
        {posts.map((p) => (
          <li>
            <a class="post-row" href={`/blog/${p.id}/`}>
              <span class="post-meta"><time datetime={p.data.pubDate.toISOString()}>{fmtDate(p.data.pubDate)}</time> · {p.data.category}</span>
              <span class="post-title">{p.data.title}</span>
              <span class="post-desc">{p.data.description}</span>
              <span class="post-more">Leer <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4"/></svg></span>
            </a>
          </li>
        ))}
      </ol>
      <div class="post-cta" style="margin-top:64px">
        <p class="statement">¿Te muestro mi setup? <span class="g">Treinta minutos, mi pantalla real, y te llevás lo que le sirva a tu equipo.</span></p>
        <div class="ctas" style="display:flex;gap:10px;flex-wrap:wrap">
          <a class="pill pill-ink" href="https://calendar.google.com/calendar/u/0/appointments/schedules/AcZssZ1_ERerY_SFciQLYK3iSLs8HwhEUT9XIO7E2XoCS4mqluKSFbzKchy6JSY0dDStcfYEp8gJYGx-" target="_blank" rel="noopener">Agendemos 30 minutos <svg class="arr arr-x" viewBox="0 0 16 16" aria-hidden="true"><path d="M5 11l6-6M6 5h5v5"/></svg></a>
          <a class="pill pill-soft" href="/rss.xml">Seguir por RSS</a>
        </div>
      </div>
    </div>
  </section>
</main>
</Base>
