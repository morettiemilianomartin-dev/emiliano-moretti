---
// Página para links rotos o viejos. Vercel la muestra en cualquier dirección que no existe, en los dos idiomas.
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
---
<Base title="Página no encontrada · Emiliano Moretti" description="Esta página no existe o cambió de dirección." noindex>
<main class="page">
  <div class="narrow">
    <PageHeader title="Esta página no existe." gray="Puede que el link esté viejo o mal copiado.">
      <p slot="kicker" class="eyebrow"><span class="num">404</span>No encontrada</p>
    </PageHeader>
    <div class="page-body">
      <div class="ctas" style="display:flex;gap:10px;flex-wrap:wrap">
        <a class="pill pill-ink" href="/">Ir al inicio</a>
        <a class="pill pill-soft" href="/blog/">Ver el blog</a>
      </div>
      <p class="blog-note" lang="en">Page not found. Go to the <a href="/en/" hreflang="en">English home</a> or the <a href="/en/blog/" hreflang="en">blog in English</a>.</p>
    </div>
  </div>
</main>
</Base>
